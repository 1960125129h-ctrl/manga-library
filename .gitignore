# ---- 书库内容（几百 GB 级）绝不进仓库 ----
漫画/
_thumbs/
_预览/
_预览页/
_zips/
_对比图/

# ---- 构建产物 ----
_dist/
书库.html
_manifest.json
library.json
角色作品表.json
外部目录.json

# ---- 运行时状态 ----
.progress.json
.workbench.json
reader-prefs.json
*.log
_pkg-boot.log

# ---- 依赖 ----
node_modules/
_app/node_modules/

# ---- 抓取用的浏览器 profile（含登录态，且被进程锁着）与临时产物，统一在 _cache/ ----
_cache/
_scripts/jm/logs/

# ---- 备份与临时 ----
_logs/            # 横向滚动排查日志（一次性工具产物，不进版本库）
_backup/
_backup_*/
_archive/
_css-backup/
_*.cjs
_batch.json
*.tmp

# ---- 第三方二进制（ffmpeg/ffprobe/ffplay 三个 exe 近 295 MB，装包时拷进来即可） ----
_scripts/tools/

# ---- 运行时日志 ----
*.jsonl
session*.jsonl
_scripts/jm/.app-pid
_scripts/jm/.app-port

# ---- 抓取站点的登录 cookie（绝不能进仓库） ----
_scripts/sites/cookies/
_scripts/sites/download-prefs.json

# ---- 运行状态 / 抓取缓存 / 调试产物(不进仓库) ----
_scripts/jm/.port
_scripts/jm/pending.json
_scripts/jm/queue.json
_scripts/jm/_zm*.html
_scripts/jm/_manga-only*
_scripts/jm/待下载*.txt
_scripts/sites/cache-pixiv*.json
_visual-check/2.0/
_visual-check/dl-general.png
_visual-check/verify-panel.png
_scripts/sites/*cookies*
_scripts/sites/cache-x.json
_scripts/sites/cache-douyin.json
