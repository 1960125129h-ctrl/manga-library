{
  "name": "manga-library-v0",
  "version": "1.1.3",
  "description": "本地漫画书库 - 书库/阅读器/下载器",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "author": "漫画书库",
  "license": "MIT",
  "dependencies": {
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.manga.library.v0",
    "productName": "书库",
    "directories": {
      "output": "../_dist"
    },
    "files": [
      "**/*",
      "!package-lock.json",
      "!smoke-result.json",
      "!icon-d2.svg",
      "!make-icon.js",
      "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md,README,readme,*.md,*.markdown}",
      "!**/node_modules/.bin",
      "!**/node_modules/@img/sharp-wasm32/**",
      "!**/{.git,.github,.vscode,.idea,test,tests,__tests__,coverage,docs,examples,demos}"
    ],
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ],
    "extraResources": [
      {
        "from": "../_scripts",
        "to": "_scripts",
        "filter": [
          "**/*",
          "!**/_cache/**",
          "!**/_archive/**",
          "!**/jm/logs/**",
          "!**/node_modules/**",
          "!**/*.log",
          "!**/tools/ffmpeg/**/bin/ffplay.exe",
          "!**/tools/**/doc/**",
          "!**/_历史验收脚本/**",
          "!**/sites/cookies/**",
          "!**/sites/*cookies*",
          "!**/sites/*.txt",
          "!**/sites/download-prefs.json",
          "!**/sites/cache-pixiv*.json",
          "!**/jm/.port",
          "!**/jm/.app-pid",
          "!**/jm/pending.json",
          "!**/jm/queue.json",
          "!**/jm/_zm*.html",
          "!**/jm/*.txt",
          "!**/cmp70504.mjs",
          "!**/preset-check.mjs",
          "!**/jm/p013052.mjs",
          "!**/jm/probe623756.mjs",
          "!**/jm/v733851.mjs",
          "!**/jm/x7242143.mjs",
          "!**/jm/smoke-ref.mjs",
          "!**/jm/make-fixture.mjs",
          "!**/jm/verify-import.mjs",
          "!**/jm/ocr_server.py",
          "!**/jm/run-album.mjs",
          "!**/jm/jmcomic_dl.py",
          "!**/jm/README.md",
          "!**/*.md"
        ]
      },
      {
        "from": "../src",
        "to": "src",
        "filter": [
          "**/*",
          "!**/legacy-jm.js",
          "!**/*.md"
        ]
      },
      {
        "from": "../icons",
        "to": "icons",
        "filter": [
          "**/*",
          "!**/*.html"
        ]
      },
      {
        "from": "../manifest.webmanifest",
        "to": "manifest.webmanifest"
      },
      {
        "from": "../service-worker.js",
        "to": "service-worker.js"
      },
      {
        "from": "../_pkg-template/library.json",
        "to": "library.json"
      },
      {
        "from": "../角色作品表.json",
        "to": "角色作品表.json"
      },
      {
        "from": "../外部目录.json",
        "to": "外部目录.json"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "fileAssociations": [
      {
        "ext": "cbz",
        "name": "漫画压缩包",
        "description": "漫画压缩包 (CBZ)",
        "icon": "icon.ico",
        "role": "Viewer"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "书库",
      "artifactName": "书库-${version}-setup.exe",
      "include": "installer.nsh"
    },
    "portable": {
      "artifactName": "书库-${version}-portable.exe"
    },
    "compression": "maximum"
  }
}
